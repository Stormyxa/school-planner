{
  "crons": [
    {
      "path": "/api/push?action=check-deadlines",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(sw\\.js|sw-custom\\.js|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
